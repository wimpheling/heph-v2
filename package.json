{
  "name": "heph-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @heph/web dev",
    "dev:server": "go run ./cmd/heph",
    "generate": "buf generate",
    "check": "vp check && pnpm typecheck && buf lint && pnpm check:go",
    "typecheck": "pnpm --filter @heph/web exec tsc -b && tsc -p packages/design-system/tsconfig.json && pnpm --filter @heph/e2e typecheck",
    "test": "node --test tools/oxlint/*.test.mjs scripts/coverage.test.mjs && go test -race ./...",
    "test:coverage": "node scripts/coverage.mjs all",
    "test:coverage:unit": "node scripts/coverage.mjs unit",
    "test:coverage:e2e": "node scripts/coverage.mjs e2e",
    "coverage:merge": "node scripts/coverage.mjs merge",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "go run ./cmd/heph migrate",
    "db:reset": "go run ./cmd/heph reset",
    "build": "pnpm --filter @heph/web build && go build -o bin/heph ./cmd/heph",
    "fmt": "vp fmt && node scripts/go-fmt.mjs --write",
    "test:e2e": "pnpm --filter @heph/e2e test",
    "test:e2e:ui": "pnpm --filter @heph/e2e test:ui",
    "check:go": "node scripts/go-fmt.mjs && go vet ./... && pnpm lint:go",
    "lint:go": "go run ./tools/go-lint/cmd/hephlint ./...",
    "test:go-lints": "go test ./tools/go-lint/..."
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
