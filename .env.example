# Explicit local configuration, not application defaults. Missing values must fail.
# No hardcoded environment defaults are permitted in code or Compose.
# Replace tokens before starting the application. Export this file in your shell.
POSTGRES_DB=heph
POSTGRES_USER=heph
POSTGRES_PASSWORD=heph-local-placeholder
POSTGRES_PORT=5432
HEPH_DATABASE_URL=postgresql://heph:heph-local-placeholder@127.0.0.1:5432/heph?sslmode=disable
HEPH_DATABASE_SCHEMA=public
HEPH_LISTEN_ADDR=127.0.0.1:8080
HEPH_RPC_TARGET=http://127.0.0.1:8080
HEPH_BOOTSTRAP_IDENTITIES='[{"source":"bootstrap","subject":"admin","token":"replace-with-a-random-token-of-at-least-24-characters"}]'
# Isolated E2E installation. The harness allocates and removes a unique schema.
HEPH_E2E_DATABASE_URL=postgresql://heph:heph-local-placeholder@127.0.0.1:5432/heph?sslmode=disable
HEPH_E2E_BASE_URL=http://127.0.0.1:18080
HEPH_E2E_WEB_URL=http://127.0.0.1:15173
HEPH_E2E_API_ONLY=0
HEPH_E2E_MANAGED=1
